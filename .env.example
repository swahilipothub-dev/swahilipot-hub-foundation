# Server
PORT=5000
NODE_ENV=development

# CORS Configuration
# Add additional allowed origins (comma-separated)
# Common development origins are automatically included
CORS_ORIGINS=https://your-production-domain.com,https://staging.yourdomain.com

# Database
MONGO_URI=mongodb://localhost:27017/swahilipot_hub

# Authentication
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here
COOKIE_SECRET=your_cookie_secret_here

# Email (optional for now)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@swahilipothub.org
EMAIL_FROM_NAME="Swahilipot Hub"